{
    "name": "DRMS Codespaces Demo",
    "dockerComposeFile": "compose.yaml",
    "service": "app",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "24"
        }
    },
    "forwardPorts": [
        8000
    ],
    "portsAttributes": {
        "8000": {
            "label": "DRMS Demo",
            "onAutoForward": "silent"
        }
    },
    "hostRequirements": {
        "cpus": 2,
        "memory": "8gb",
        "storage": "32gb"
    },
    "postCreateCommand": "bash .devcontainer/setup-demo.sh",
    "postStartCommand": "setsid -f bash .devcontainer/start-demo.sh",
    "remoteUser": "vscode"
}
